<interface domain="safeyees">
  <requires lib="gtk" version="4.0"/>
  <template parent="GtkWindow" class="BreakScreenWindow">
    <property name="icon-name">io.github.slgobinath.SafeEyes</property>
    <property name="decorated">0</property>
    <property name="deletable">0</property>
    <signal name="close-request" handler="on_window_delete" swapped="no"/>
    <child>
      <object class="GtkBox" id="grid1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="toolbar">
            <property name="halign">end</property>
            <property name="spacing">8</property>
            <property name="margin-top">8</property>
            <property name="margin-end">12</property>
            <style><class name="toolbar"/></style>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="content_scroll">
            <property name="hexpand">1</property>
            <property name="vexpand">1</property>
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="child">
              <object class="GtkBox" id="content_column">
                <property name="orientation">vertical</property>
                <property name="spacing">16</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <child>
                  <object class="GtkPicture" id="img_break"/>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_message">
                    <property name="wrap">1</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">24</property>
                    <property name="justify">center</property>
                    <style><class name="lbl_message"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_distraction">
                    <property name="visible">0</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="hexpand">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_count">
                    <style><class name="lbl_count"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_buttons">
                    <property name="spacing">16</property>
                    <property name="halign">center</property>
                    <property name="homogeneous">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_widget">
                    <property name="wrap">1</property>
                    <property name="wrap-mode">word-char</property>
                    <property name="max-width-chars">60</property>
                    <property name="justify">center</property>
                    <style><class name="lbl_widget"/></style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="window_main"/>
    </style>
  </template>
</interface>
